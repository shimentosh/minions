{
  "name": "minions",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, self-hosted, end-to-end encrypted password manager and secrets vault for passwords, API keys, .env files, servers, 2FA codes, cards and notes.",
  "keywords": [
    "password-manager",
    "secrets-manager",
    "end-to-end-encryption",
    "self-hosted",
    "open-source",
    "bitwarden-alternative",
    "1password-alternative",
    "vault",
    "totp",
    "2fa",
    "authenticator",
    "api-keys",
    "env",
    "dotenv",
    "chrome-extension",
    "tauri",
    "nestjs",
    "react",
    "postgresql",
    "argon2"
  ],
  "homepage": "https://github.com/shimentosh/minions#readme",
  "bugs": {
    "url": "https://github.com/shimentosh/minions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shimentosh/minions.git"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "mail:up": "docker compose up -d mailpit",
    "mail:down": "docker compose stop mailpit",
    "dev": "pnpm -r --parallel --filter @minions/api --filter @minions/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "seed:demo": "node scripts/seed-demo.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "playwright": "^1.63.0",
    "typescript": "5.9.3"
  }
}
