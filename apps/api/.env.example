# Minions API configuration. Copy to .env. Never commit .env.
DATABASE_URL=postgresql://minions:minions_dev_only@localhost:55440/minions_dev
# Separate database for integration tests (created automatically by the test setup).
TEST_DATABASE_URL=postgresql://minions:minions_dev_only@localhost:55440/minions_test
PORT=4600
# Comma-separated origins allowed to call the API with credentials.
WEB_ORIGINS=http://localhost:5180,tauri://localhost,http://tauri.localhost
# Allowed extension origins, e.g. chrome-extension://<id>. Empty = any chrome-extension:// origin in development only.
EXTENSION_ORIGINS=
# 32 random bytes, base64. Encrypts the account TOTP secret at rest. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SERVER_ENCRYPTION_KEY=
# 32 random bytes, base64. Derives stable fake KDF salts for unknown emails.
PRELOGIN_SECRET=
# Optional. Without it AI classification reports "unavailable" and rules are used.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# "production" enables Secure cookies and strict origin checks.
NODE_ENV=development
# Which reverse proxies may set X-Forwarded-For (Express trust proxy). Default: loopback.
# Behind Traefik + nginx in Docker (docker-compose.prod.yml): loopback, linklocal, uniquelocal
TRUST_PROXY=
# Optional. Shares rate-limit counters between API instances (docker compose up -d redis).
REDIS_URL=redis://localhost:56379
# Passkeys: the web app host, and the origins passkeys may be used from.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5180
# Comma-separated account ids (users.id, a UUID) allowed to open the operator dashboard (/operator).
# Ids, not emails: email ownership is not verified. Find yours with
#   SELECT id FROM users WHERE email = 'you@example.com';
# Outside NODE_ENV=development those accounts must also have two-factor on. Empty = nobody.
OPERATOR_USER_IDS=
# Email (verification links), sent through the Resend API: https://resend.com
# MAIL_FROM must be an address on a domain verified in Resend. Without a key,
# emails are skipped (development only; production refuses to start).
# Development only: send mail to a local Mailpit instead (pnpm mail:up, inbox at
# http://localhost:58025). Must be a localhost URL; production refuses to start with it.
MAILPIT_URL=http://localhost:58025
RESEND_API_KEY=
MAIL_FROM=Minions <no-reply@your-domain.com>
# Where links in emails point (defaults to the first WEB_ORIGINS entry).
PUBLIC_WEB_URL=http://localhost:5180
